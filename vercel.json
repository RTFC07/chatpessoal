{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/resumo.js": { "maxDuration": 30 },
    "api/municipio.js": { "maxDuration": 60, "includeFiles": "data/locais.json" }
  },
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ]
}
